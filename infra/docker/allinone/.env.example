# Copy to .env next to docker-compose.yml. Never commit the real file.
# Passwords and keys (database, sign-in tokens, file store) are generated on the first start and kept in <data folder>/config/secrets.env.

# Where your data lives on this computer (database, pictures, backups). Default: ./data
# DS_DATA_DIR=./data

# Port to open the site on. Default 8080.
# DS_PORT=8080

# The address people open the site at (used for browser security rules). Default http://localhost:8080
# DS_PUBLIC_URL=https://societies.example.com

# Your own domain with automatic HTTPS: set it here and publish ports 80 and 443 (see docs/SELFHOST.md).
# DS_SITE=societies.example.com

# Sign-in codes are emailed from this account. For Gmail use an App Password (Google Account > Security > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Digital Societies
