# Copy this to .env — NEVER commit .env to git
# Run: cp .env.prod.example .env   then edit values

# ── Domain ─────────────────────────────────────────────────────────────────
DOMAIN=societies.athomes.space
JWT_ISSUER=https://societies.athomes.space
JWT_AUDIENCE=digital-societies-clients

# ── Generate strong secrets (run these in terminal) ─────────────────────────
# openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
JWT_SECRET_KEY=REPLACE_WITH_MIN_32_CHAR_SECRET

# ── MinIO (file storage) ─────────────────────────────────────────────────────
MINIO_ACCESS_KEY=REPLACE_WITH_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_SECRET_KEY_MIN_8_CHARS

# ── Email (sign-in codes) — required, any free SMTP relay ─────────────────────
#   Gmail -> smtp.gmail.com:587 StartTls + App Password
#   Brevo -> smtp-relay.brevo.com:587 StartTls (free tier ~300 mails/day)
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM_ADDRESS=no-reply@REPLACE_WITH_DOMAIN
SMTP_FROM_NAME=Digital Societies

# ── SMS (OPTIONAL, paid) — leave empty to disable. Login never needs SMS. ────
MSG91_API_KEY=
