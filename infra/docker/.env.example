# ── Digital Societies — Docker Compose environment variables ──────────────────
# Copy to infra/docker/.env and fill in secrets. Never commit .env.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=ds_admin
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=digital_societies

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET_KEY=replace_with_a_64_char_random_secret

# ── Email (sign-in codes) — free SMTP ────────────────────────────────────────
# Dev: leave SMTP_HOST empty. In the dev compose override Mailpit catches all mail
#      at http://localhost:8025. Prod: any SMTP relay, e.g.
#      Gmail   -> smtp.gmail.com:587 StartTls + an App Password
#      Brevo   -> smtp-relay.brevo.com:587 StartTls (free tier ~300 mails/day)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=StartTls          # StartTls | SslOnConnect | None
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Digital Societies

# ── SMS (OPTIONAL, paid) — leave MSG91_API_KEY empty to disable SMS entirely ──
# Login never needs SMS; it is only used for visitor/payment fallback alerts.
MSG91_API_KEY=
MSG91_SENDER_ID=DGSOC

# ── Expo Push Notifications ───────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=your_expo_access_token

# ── OpenTelemetry / Observability ─────────────────────────────────────────────
OTEL_ENDPOINT=http://otel-collector:4317
GRAFANA_PASSWORD=admin

# ── Caddy (reverse proxy) ─────────────────────────────────────────────────────
# Domain pointing to this server (leave localhost for local dev)
DOMAIN=localhost

# ── Web Admin ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_HUB_URL=http://localhost:5000/hubs
NEXT_PUBLIC_MAP_TILE_URL=https://demotiles.maplibre.org/style.json
