# Copy to <DS_DATA_DIR>/selfhost.env. Never commit the real file.

# Folder that holds ALL data (database, files, cache, backups). Use forward slashes.
DS_DATA_DIR=D:/ClaudeWorkspace/ds-data

# Random secrets: generate each with  python -c "import secrets;print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET_KEY=
JWT_ISSUER=https://api.digitalsocieties.app
JWT_AUDIENCE=digital-societies-clients
QR_TOKEN_SECRET_KEY=
JITSI_APP_SECRET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Where the app is allowed to be opened from (the web console, if you run it)
WEB_ADMIN_URL=http://localhost:3000

# Sign-in codes are emailed with this account. For Gmail use an App Password (Google Account > Security > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Digital Societies
